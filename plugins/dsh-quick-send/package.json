{
  "name": "@wenliang9527/dsh-quick-send",
  "version": "0.3.0",
  "description": "常用语快捷发送：输入框上方的常用语面板，一键填入草稿（不覆盖、不自动发送）。与 ZCode quick-send 共享同一份 phrases.json 内容源，pinned/order 各侧本地。",
  "type": "module",
  "license": "MIT",
  "author": "wenliang9527",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenliang9527/quick-send.git",
    "directory": "plugins/dsh-quick-send"
  },
  "homepage": "https://github.com/wenliang9527/quick-send/tree/master/plugins/dsh-quick-send#readme",
  "bugs": {
    "url": "https://github.com/wenliang9527/quick-send/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quick-send",
    "snippets",
    "composer"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/store.test.mjs test/client.test.mjs test/e2e.test.mjs test/agent-tools.test.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
