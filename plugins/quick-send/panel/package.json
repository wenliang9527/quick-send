{
  "name": "quick-send-panel",
  "version": "0.5.3",
  "description": "Quick-Send 面板（MCP App）：Rust 原生 server + 面板构建",
  "scripts": {
    "build": "node build.mjs",
    "build:server": "cargo build --release --manifest-path server-rs/Cargo.toml && node scripts/copy-server.mjs",
    "test:rust": "cargo test --release --manifest-path server-rs/Cargo.toml",
    "test": "node --test test/i18n.test.mjs test/concurrency.test.mjs && node test/smoke.mjs",
    "start": "server/bin/quick-send-server.exe"
  },
  "type": "module",
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "private": true
}
