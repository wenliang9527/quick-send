{
  "name": "quick-send",
  "version": "0.4.0",
  "description": "会话侧栏快捷发送面板：常用语管理，一键复制到剪贴板或发送（分类/搜索/置顶/占位符，Rust 原生后端 ~4MB 内存）。",
  "keywords": ["snippets", "quick-send", "clipboard", "mcp-app", "productivity", "rust"],
  "mcpServers": {
    "quick-send": {
      "type": "stdio",
      "command": "${ZCODE_PLUGIN_ROOT}/panel/server/bin/quick-send-server.exe",
      "args": [],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "QUICK_SEND_DATA": "${ZCODE_PLUGIN_DATA}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "quick-send",
        "title": { "zh-CN": "快捷发送", "en": "Quick Send" },
        "server": "quick-send",
        "resourceUri": "ui://quick-send/panel.html",
        "availability": "session"
      }
    ]
  }
}
