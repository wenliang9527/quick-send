{
  "name": "quick-send",
  "version": "0.5.3",
  "description": "会话侧栏快捷发送面板：常用语与 DSH 双向共享（shared-phrases），一键复制/发送（分类/搜索/置顶/占位符，Rust 原生后端 ~4MB）。",
  "keywords": ["snippets", "quick-send", "clipboard", "mcp-app", "productivity", "rust", "shared"],
  "userConfig": {
    "phrasesPath": {
      "type": "string",
      "default": "D:\\WORK_VSCODE\\Vibe-coding\\shared-phrases\\phrases.json",
      "description": "共享常用语文件路径（与 DSH 侧共用同一内容源）"
    }
  },
  "mcpServers": {
    "quick-send": {
      "type": "stdio",
      "command": "${ZCODE_PLUGIN_ROOT}/panel/server/bin/quick-send-server.exe",
      "args": [],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "QUICK_SEND_DATA": "${ZCODE_PLUGIN_DATA}",
        "QUICK_SEND_PHRASES": "${user_config.phrasesPath}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "quick-send",
        "title": { "zh-CN": "快捷发送", "en": "Quick Send" },
        "server": "quick-send",
        "resourceUri": "ui://quick-send/panel.html",
        "availability": "session"
      }
    ]
  }
}
